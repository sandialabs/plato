# This is a Spack Environment file.
#
# It describes a set of packages to be installed, along with
# configuration settings.
spack:
  specs: [platoanalyze@develop~amgx~cuda+dakota_tests+enginemesh+esp+mpmd+tacho 
          ^dakota cxxflags="-fno-new-ttp-matching" fflags="-fallow-argument-mismatch" ^esp@BetaLin ^openmpi@4.1.3 
          ^platoengine@develop+dakota+esp~expy+sierra_tests ^trilinos~mumps]
